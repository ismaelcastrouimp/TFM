Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"H", "[", 
     RowBox[{"g_", ",", "v_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", ",", "g", ",", "g", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g", ",", 
        RowBox[{"-", "v"}], ",", "0", ",", "g"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g", ",", "0", ",", 
        RowBox[{"-", "v"}], ",", "g"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "g", ",", "g", ",", "v"}], "}"}]}], "}"}]}], ";"}], 
  "\n"}]], "Input",
 CellChangeTimes->{
  3.9723063489798393`*^9, {3.9723624496554375`*^9, 3.9723624515218124`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"9a62e455-f9b7-fb4d-9cb7-17498d280aa4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rho", "[", 
     RowBox[{"g_", ",", "v_", ",", "T_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"1", "/", "T"}]}], ",", "Z"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Z", "=", 
        RowBox[{"Tr", "[", 
         RowBox[{"MatrixExp", "[", 
          RowBox[{
           RowBox[{"-", "beta"}], " ", 
           RowBox[{"H", "[", 
            RowBox[{"g", ",", "v"}], "]"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "beta"}], " ", 
          RowBox[{"H", "[", 
           RowBox[{"g", ",", "v"}], "]"}]}], "]"}], "/", "Z"}]}]}], "]"}]}], 
   ";"}], "\n"}]], "Input",
 CellChangeTimes->{3.972306381223522*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"53a4ba34-d556-5240-a1ae-c04532c15ae2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vonNeumannEntropy", "[", "matrix_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigs", "=", 
        RowBox[{"Eigenvalues", "[", "matrix", "]"}]}], "}"}], ",", 
      RowBox[{"-", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"eigs", ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}]}], "]"}], "*", 
         RowBox[{"Log", "[", 
          RowBox[{"Select", "[", 
           RowBox[{"eigs", ",", 
            RowBox[{
             RowBox[{"#", ">", "0"}], "&"}]}], "]"}], "]"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{3.9723064231269016`*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"6ede7b1a-e8e4-8b40-ae06-c1ddc99f51a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"internalEnergy", "[", 
     RowBox[{"g_", ",", "v_", ",", "T_"}], "]"}], ":=", 
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"g", ",", "v", ",", "T"}], "]"}], ".", 
      RowBox[{"H", "[", 
       RowBox[{"g", ",", "v"}], "]"}]}], "]"}]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{3.972306437187229*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"600ff967-a4cd-8948-85a4-56a9885536d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"freeEnergy", "[", 
     RowBox[{"g_", ",", "v_", ",", "T_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"internalEnergy", "[", 
      RowBox[{"g", ",", "v", ",", "T"}], "]"}], "-", 
     RowBox[{"T", "*", 
      RowBox[{"vonNeumannEntropy", "[", 
       RowBox[{"rho", "[", 
        RowBox[{"g", ",", "v", ",", "T"}], "]"}], "]"}]}]}]}], ";"}], 
  "\n"}]], "Input",
 CellChangeTimes->{3.9723067803311863`*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"95c4d893-dac2-b740-ab18-2ce45548fe0c"],

